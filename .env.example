# ==============================================================================
# 5ª CORRIDA DE EMANCIPAÇÃO POLÍTICA DE LAJES PINTADAS/RN - AMBIENTE (.env)
# ==============================================================================

# Conexão com Supabase (PostgreSQL + Stored Procedures)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica-do-supabase

# Gateway de Pagamentos Asaas (API v3)
# Obtenha em: Minha Conta > Configurações da Conta > Integrações > Chaves de API
ASAAS_API_KEY=$aact_YTU5YTE0M2M6N2Z...
ASAAS_ENVIRONMENT=sandbox # 'sandbox' para testes ou 'production' para evento real

# Token Secreto de Autenticação do Webhook do Asaas (Header: asaas-access-token)
# Deve coincidir exatamente com o configurado na tela de Webhooks do Asaas
ASAAS_WEBHOOK_SECRET=token_secreto_webhook_lajes_2026_seguro

# Credenciais de Acesso Administrativo Inicial
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=LajesPintadas2026!
